{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":enableVulnerabilityAlerts", "security:minimumReleaseAgeNpm"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge minor and patch, never pre-1.0 (0.x may break on any release)",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    }
  ]
}
